* text=auto eol=lf

*.py    text diff=python
*.md    text
*.xml   text
*.json  text
*.yml   text
*.sh    text eol=lf

# Binary, never diffed
*.npz   binary
*.pt    binary
*.png   binary
*.gif   binary
*.mp4   binary

# Git LFS rules for the formats that would otherwise bloat history. No file
# matching these is committed today: rollout MP4s are regenerated by
# `make videos`, and the trained weights that are committed are small enough
# (a few hundred kB) to live in Git directly. The rules are here so that the
# first person to commit a large artefact does the right thing by default.
*.mp4   filter=lfs diff=lfs merge=lfs -text
*.mkv   filter=lfs diff=lfs merge=lfs -text
*.usd   filter=lfs diff=lfs merge=lfs -text
*.usdz  filter=lfs diff=lfs merge=lfs -text
*.bag   filter=lfs diff=lfs merge=lfs -text
