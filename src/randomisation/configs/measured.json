{
  "name": "measured",
  "scale": 1.0,
  "_comment": [
    "Ranges taken from published measurements rather than from plausibility.",
    "Every entry is sourced in docs/randomisation-sources.md; the short version",
    "is that the hand-picked levels are optimistic on latency and sensing and",
    "omit orientation error entirely. This level is not a training curriculum,",
    "it is an evaluation distribution: it asks what the policies score when the",
    "sensing and actuation are as bad as the literature says they are."
  ],
  "params": {
    "object_half_size": {
      "low": 0.85,
      "high": 1.1,
      "mode": "scale"
    },
    "object_mass": {
      "low": 0.5,
      "high": 2.0,
      "mode": "scale"
    },
    "object_friction": {
      "low": 0.46,
      "high": 1.9,
      "mode": "scale"
    },
    "table_friction": {
      "low": 0.46,
      "high": 1.9,
      "mode": "scale"
    },
    "gripper_gain": {
      "low": 0.7,
      "high": 1.4,
      "mode": "scale"
    },
    "hand_compliance": {
      "low": 0.7,
      "high": 1.8,
      "mode": "scale"
    },
    "action_latency": {
      "low": 1.0,
      "high": 6.0,
      "mode": "absolute"
    },
    "gravity": {
      "low": 0.999,
      "high": 1.001,
      "mode": "scale"
    },
    "obs_noise_pos": {
      "low": 0.004,
      "high": 0.010,
      "mode": "absolute"
    },
    "obs_noise_vel": {
      "low": 0.0,
      "high": 0.05,
      "mode": "absolute"
    },
    "obs_noise_rot": {
      "low": 0.14,
      "high": 0.31,
